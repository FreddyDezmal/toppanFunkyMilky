# Editor and analyser settings shared by everyone working on this repository.
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{json,xml,csproj,props,targets,ts,tsx,js,jsx,css,html,yml,yaml,md}]
indent_size = 2

# EF Core migrations are generated by `dotnet ef`. Treat them as generated code so code-quality
# analysers (e.g. CA1861) do not fail the build on code we never write by hand.
[**/Persistence/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none